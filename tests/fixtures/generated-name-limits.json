    },
    "AWS::ECS::Cluster": {
      "nameProperty": "ClusterName",
      "apiMaxLength": 255,
      "apiSource": "CreateCluster clusterName"
    },
    "AWS::ECS::Service": {
      "nameProperty": "ServiceName",
      "apiMaxLength": 255,
      "apiSource": "CreateService serviceName"
    },
    "AWS::Logs::LogGroup": {
      "nameProperty": "LogGroupName",
      "schemaMaxLength": 512,
      "schemaPattern": "^[.\\-_/#A-Za-z0-9]{1,512}\\Z"
    },
    "AWS::CloudWatch::Alarm": {
