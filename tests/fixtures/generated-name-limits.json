{
  "_about": "Name-property limits for every FALLBACK_NAME_RULES type (go-to-k/cdkd#5064). schema* fields are copied from AWS's public CloudFormation schema bundle (CloudformationSchema.zip, 2026-10-19); apiMaxLength is the service API's limit where the schema is silent or bounds only an ARN form.",
  "types": {
    "AWS::S3::Bucket": {
      "nameProperty": "BucketName",
      "apiMaxLength": 63,
      "apiSource": "S3 bucket naming rules"
    },
    "AWS::SQS::Queue": {
      "nameProperty": "QueueName",
      "apiMaxLength": 80,
      "apiSource": "CreateQueue QueueName"
    },
    "AWS::SNS::Topic": {
      "nameProperty": "TopicName",
      "apiMaxLength": 256,
      "apiSource": "CreateTopic Name"
    },
    "AWS::Lambda::Function": {
      "nameProperty": "FunctionName",
      "apiMaxLength": 64,
      "apiSource": "CreateFunction FunctionName (name form)"
    },
    "AWS::Lambda::LayerVersion": {
      "nameProperty": "LayerName",
      "apiMaxLength": 64,
      "apiSource": "PublishLayerVersion LayerName (name form)"
    },
    "AWS::Lambda::CapacityProvider": {
      "nameProperty": "CapacityProviderName",
      "schemaMaxLength": 140,
      "schemaPattern": "^(arn:aws[a-zA-Z-]*:lambda:(eusc-)?[a-z]{2}((-gov)|(-iso([a-z]?)))?-[a-z]+-\\d{1}:\\d{12}:capacity-provider:[a-zA-Z0-9-_]+)|[a-zA-Z0-9-_]+$",
      "apiMaxLength": 64,
      "apiSource": "measured: CreateCapacityProvider refuses a name over 64 (go-to-k/cdkd#5064)"
    },
    "AWS::IAM::Role": {
      "nameProperty": "RoleName",
