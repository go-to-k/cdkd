# TypeScript build artifacts
*.js
*.d.ts
*.js.map

# Dependencies
node_modules/
package-lock.json
# The pnpm twin `*/pnpm-lock.yaml` is ignored by the ROOT .gitignore instead,
# because a root-relative pattern belongs in the top-level file
# (go-to-k/cdkd#2838).

# CDK output
cdk.out/

# Keep source files
!bin/*.ts
!lib/*.ts
