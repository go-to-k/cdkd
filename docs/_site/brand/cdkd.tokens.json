        "tracking": "0.08em"
      },
      "code": {
        "size": "0.875rem",
        "leading": "1.375rem",
        "weight": 400,
        "tracking": "0em"
      },
      "metric": {
        "size": "2rem",
        "leading": "2.5rem",
        "weight": 500,
        "tracking": "-0.025em"
      }
