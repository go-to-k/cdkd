  "typography": {
    "fontFamily": {
      "sans": "\"Geist\", \"Noto Sans JP\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "jp": "\"Noto Sans JP\", \"Geist\", system-ui, sans-serif",
      "mono": "\"Geist Mono\", \"Noto Sans JP\", ui-monospace, SFMono-Regular, Consolas, monospace"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "fontFeatures": {
      "ui": "\"kern\" 1, \"liga\" 1",
      "code": "\"liga\" 0, \"calt\" 0"
    },
    "dataNumeric": "tabular-nums lining-nums slashed-zero",
    "scale": {
      "display": {
        "size": "3.5rem",
