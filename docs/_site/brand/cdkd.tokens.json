      "weight": 500,
      "tracking": "0em"
    },
    "japaneseBody": "body-jp",
    "overlineScope": "Latin only"
  },
  "space": {
    "0": "0rem",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px"
  },
  "size": {
    "control-height": "44px",
    "icon-sm": "16px",
    "icon": "20px",
    "icon-lg": "24px"
  },
  "border": {
    "width": "1px",
    "focus-width": "2px",
    "focus-offset": "3px",
    "icon-stroke": "2px"
  },
  "layout": {
    "max": "75rem",
    "gutter": "1.5rem",
    "measure": "68ch",
    "measure-jp": "40em",
    "breakpoint": "48rem",
    "columns-desktop": 12,
    "columns-mobile": 4,
    "gutter-mobile": "1rem"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "180ms",
      "slow": "240ms"
    },
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "distance": "4px",
    "reduced": {
      "duration": "0ms",
      "distance": "0px"
    }
  },
  "components": {
    "button": {
      "minHeight": "44px",
      "minTargetWidth": "44px",
      "paddingInline": "16px",
      "gap": "8px",
      "radius": "8px",
      "type": "label",
      "background": "color.accent",
      "text": "color.on-accent",
      "border": "color.accent-border"
    },
    "field": {
      "minHeight": "44px",
      "paddingInline": "12px",
      "radius": "8px",
      "type": "body",
      "background": "color.surface",
      "text": "color.text",
      "placeholder": "color.text-muted",
      "border": "color.border"
    },
    "card": {
      "padding": "24px",
      "radius": "12px",
      "border": "color.border-subtle"
    },
    "panel": {
      "padding": "32px",
      "radius": "16px",
      "background": "color.surface"
    },
    "status": {
      "gap": "8px",
      "radius": "4px",
      "type": "label",
      "textAndIconRequired": true
    },
    "focus": {
      "width": "2px",
      "offset": "3px",
      "color": "color.focus"
    }
  }
}
