{
  "meta": {
    "name": "cdkd brand system",
    "version": "1.0.0",
    "date": "2026-10-09",
    "format": "plain structured project JSON",
    "cssPrefix": "--cdkd-",
    "description": "Approved option 2. Solid navy/orange cloud and route. No purple or glow.",
    "baseRem": "Specimens use the browser default 16px root; do not lock user font size.",
    "notes": [
      "This is a proposed cdkd palette, not a claim that the entire palette is official AWS branding.",
      "Component color paths document semantic use; these are not DTCG aliases.",
      "The audit verifies specified opaque sRGB pairs, not full product accessibility."
    ],
    "sources": [
      {
        "id": "contrast-minimum",
        "title": "W3C — WCAG 2.2 Understanding 1.4.3 Contrast (Minimum)",
        "url": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html"
      },
      {
        "id": "non-text-contrast",
        "title": "W3C — WCAG 2.2 Understanding 1.4.11 Non-text Contrast",
        "url": "https://www.w3.org/WAI/WCAG22/Understanding/non-text-contrast.html"
      },
      {
        "id": "use-of-color",
        "title": "W3C — WCAG 2.2 Understanding 1.4.1 Use of Color",
        "url": "https://www.w3.org/WAI/WCAG22/Understanding/use-of-color.html"
      },
      {
        "id": "target-size",
        "title": "W3C — WCAG 2.2 Understanding 2.5.8 Target Size (Minimum)",
        "url": "https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum"
      },
      {
        "id": "reduced-motion",
        "title": "W3C — Technique C39: CSS prefers-reduced-motion",
        "url": "https://www.w3.org/WAI/WCAG22/Techniques/css/C39"
      }
    ]
  },
